// use prisma-8

model Todo {
  id          Uuid              @id @default(uuid())
  userId      Uuid              @map("user_id")
  title       String
  isCompleted Boolean           @default(false) @map("is_completed")
  dueDate     DateString?       @map("due_date")
  createdAt   TimestamptzString @default(now()) @map("created_at")

  @@map("todos")
  @@rls
}

// Existing Supabase RLS policies, adopted verbatim so the contract matches
// the live database (these predate Prisma management of this table).
policy_delete Users_can_delete_their_own_todos {
  target = Todo
  roles = [authenticated]
  using = "(auth.uid() = user_id)"
  @@map("Users can delete their own todos")
}

policy_insert Users_can_insert_their_own_todos {
  target = Todo
  roles = [authenticated]
  withCheck = "(auth.uid() = user_id)"
  @@map("Users can insert their own todos")
}

policy_update Users_can_update_their_own_todos {
  target = Todo
  roles = [authenticated]
  using = "(auth.uid() = user_id)"
  withCheck = "(auth.uid() = user_id)"
  @@map("Users can update their own todos")
}

policy_select Users_can_view_their_own_todos {
  target = Todo
  roles = [authenticated]
  using = "(auth.uid() = user_id)"
  @@map("Users can view their own todos")
}
